[Unit]
Description=AirPlay to Raumfeld bridge (one AirPlay speaker per Raumfeld room)
Wants=network-online.target
# nqptp.service: a machine that runs its own nqptp gets to start it first; the bridge then uses it.
After=network-online.target avahi-daemon.service dbus.service nqptp.service
Requires=avahi-daemon.service

[Service]
Type=simple
User=raumfeld-airplay
Group=raumfeld-airplay
RuntimeDirectory=raumfeld-airplay
RuntimeDirectoryMode=0755
StateDirectory=raumfeld-airplay
# The bridge runs nqptp, which listens on the PTP ports 319 and 320.
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitRTPRIO=6
PrivateTmp=yes
WorkingDirectory=/opt/raumfeld-airplay
# Options such as --max-volume and --format are in this file, as OPTIONS="...".
EnvironmentFile=-/etc/default/raumfeld-airplay
ExecStart=/usr/bin/python3 -u -m raumfeld_airplay $OPTIONS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
